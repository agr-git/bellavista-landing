# Bellavista Coffee — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# ----- Resend (transactional email) -----
# Primary form delivery channel. See ADR-003.
RESEND_API_KEY=
RESEND_FROM=leads@bellavistacoffee.co

# ----- Notion (Resources DB writer) -----
# Best-effort form backup. See ADR-003.
NOTION_TOKEN=
NOTION_RESOURCES_DB_ID=

# ----- NextAuth simple auth -----
# Generate secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000        # Production: https://bellavista-coffee.com.co
# Validator-only expected origin. Set to localhost for local validation.
AUTH_EXPECTED_BASE_URL=http://localhost:3000
ADMIN_EMAIL=                              # Bootstrap/admin email for members/admin access
# Optional shared gate. Leave blank to allow any existing bv_users email.
MEMBERS_ACCESS_CODE=

# ----- Supabase -----
# Project settings → API → URL + service_role key (NOT anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Substack RSS -----
# Full feed URL, e.g. https://bellavistacoffee.substack.com/feed
# Leave blank while the Substack is not yet live — /members shows an empty state.
SUBSTACK_FEED_URL=

# ----- Public env vars (safe to expose client-side) -----
# Substack publication URL for "All posts ↗" links
NEXT_PUBLIC_SUBSTACK_URL=https://substack.com
