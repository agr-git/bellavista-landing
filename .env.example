# Bellavista Coffee — environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# ----- Resend (transactional email) -----
# Primary form delivery channel. See ADR-003.
RESEND_API_KEY=
RESEND_FROM=leads@bellavistacoffee.co

# ----- Notion (Resources DB writer) -----
# Best-effort form backup. See ADR-003.
NOTION_TOKEN=
NOTION_RESOURCES_DB_ID=

# ----- NextAuth (admin auth) -----
# Generate secret: `openssl rand -base64 32`
# Generate hash: `node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
